# Canonical production URL used for:
#   - canonical link tags (src/lib/siteConfig.ts, rendered via src/components/seo/SEO.tsx)
#   - Open Graph / Twitter URLs
# Leave empty in development to fall back to the clinic domain from the client brief,
# or set a staging URL while previewing.
# This is not a secret — it is safe to commit non-empty values for public domains.
VITE_SITE_URL=
