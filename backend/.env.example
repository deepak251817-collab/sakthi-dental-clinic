[TEMPLATE]
# PostgreSQL connection string for Prisma.
# Local development example (never commit the real .env):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sakthi_dental_clinic

# Secret used to sign admin JWTs. Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the API listens on
PORT=5000

# Allowed CORS origin (the frontend URL)
FRONTEND_URL=http://localhost:5173

# Development seed admin (used only by `npm run db:seed` — never commit real credentials)
ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=admin@sakthidentalclinic.in
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Email notifications (optional — Phase 5)
#
# With the default provider no email is sent; notifications are written to the
# server log so the system runs without any external email account.
# Set EMAIL_PROVIDER=resend to deliver real email via the Resend HTTP API.
# Only the variables the selected provider requires are needed.
# Never commit real values from this file.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=logger
# Required when EMAIL_PROVIDER=resend: verified sender, e.g. Sakthi Dental Clinic <no-reply@sakthidentalclinic.in>
EMAIL_FROM=
# Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=
