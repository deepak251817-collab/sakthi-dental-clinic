generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

/// A guest appointment request submitted from the public website.
/// Patients are not accounts — the admin team manages these requests.
model Appointment {
  id            String            @id @default(cuid())
  name          String
  phone         String
  email         String
  preferredDate DateTime?         @map("preferred_date") @db.Date
  preferredTime String?           @map("preferred_time")
  treatment     String?
  message       String?
  status        AppointmentStatus @default(PENDING)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  notifications NotificationLog[]
  activities    AppointmentActivity[]

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([preferredDate])
  @@map("appointments")
}

/// Internal admin who manages appointment requests. Passwords are only
/// ever stored as bcrypt hashes.
model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  activities AppointmentActivity[]

  @@map("admin_users")
}

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_COMPLETED
}

enum NotificationChannel {
  EMAIL
}

enum NotificationStatus {
  SENT
  FAILED
}

/// One row per attempted notification delivery. Kept for operational
/// visibility — a FAILED row never affects the appointment itself.
/// Logs are meaningless without their appointment, so they cascade on delete.
model NotificationLog {
  id            String              @id @default(cuid())
  appointmentId String              @map("appointment_id")
  type          NotificationType
  channel       NotificationChannel @default(EMAIL)
  recipient     String
  status        NotificationStatus
  errorMessage  String?             @map("error_message")
  createdAt     DateTime            @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([createdAt])
  @@map("notification_logs")
}

enum ActivityAction {
  REQUEST_CREATED
  STATUS_CHANGED
  APPOINTMENT_DELETED
}

/// Audit trail for appointment lifecycle events. Written in the same
/// transaction as the change it describes, so the trail cannot drift from
/// reality. Activity rows cascade on delete — once an appointment is removed,
/// its history is removed with it (the DELETED row itself is written first,
/// inside the deleting transaction).
model AppointmentActivity {
  id             String             @id @default(cuid())
  appointmentId  String             @map("appointment_id")
  adminId        String?            @map("admin_id")
  actorName      String?            @map("actor_name")
  action         ActivityAction
  previousStatus AppointmentStatus? @map("previous_status")
  newStatus      AppointmentStatus? @map("new_status")
  createdAt      DateTime           @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  admin       AdminUser?  @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([createdAt])
  @@map("appointment_activities")
}
